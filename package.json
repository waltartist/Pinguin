{
  "name": "pi-gui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Desktop GUI wrapper for the Pi coding agent",
  "scripts": {
    "dev:webview": "vite dev",
    "dev:webview:build-watch": "vite build --watch",
    "dev:backend": "node src/backend/main.js",
    "dev": "concurrently \"npm run dev:webview\" \"npm run dev:backend\"",
    "dev:all": "npx @neutralinojs/neu run",
    "dev:all-legacy": "concurrently --kill-others \"npm run dev:webview\" \"neu run\"",
    "build:webview": "vite build",
    "build": "npm run build:webview && neu build",
    "start": "neu run"
  },
  "dependencies": {
    "@neutralinojs/lib": "^6.7.0",
    "dockview-react": "^4.13.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@neutralinojs/neu": "^11.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
