{
  "name": "pinguin",
  "version": "0.1.0-beta.3",
  "private": true,
  "type": "module",
  "description": "Beta desktop GUI for the Pi coding agent",
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev:webview": "vite build --watch",
    "dev:webview:build-watch": "vite build --watch",
    "dev:backend": "node src/backend/main.js",
    "dev": "concurrently \"npm run dev:webview\" \"npm run dev:backend\"",
    "dev:all": "node scripts/start-dev.js",
    "dev:all-legacy": "concurrently --kill-others \"npm run dev:webview\" \"neu run\"",
    "build:webview": "vite build",
    "build": "npm run build:webview && neu build",
    "prestart": "npm run build:webview",
    "start": "neu run",
    "start:debug": "node scripts/start-dev.js --debug-window",
    "check:neutralino": "node scripts/check-neutralino-globals.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm run build:webview"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.0",
    "@neutralinojs/lib": "^6.7.0",
    "dockview-react": "^7.0.4",
    "esbuild": "0.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@neutralinojs/neu": "^11.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "^10.0.4",
    "typescript": "^7.0.2",
    "vite": "8.0.14"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
