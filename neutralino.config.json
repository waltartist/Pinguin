{
  "applicationId": "dev.pinguin.app",
  "version": "0.1.0-beta.1",
  "defaultMode": "window",
  "port": 0,
  "url": "/",
  "documentRoot": "/resources/",
  "enableServer": true,
  "enableNativeAPI": true,
  "enableExtensions": true,
  "exportAuthInfo": true,
  "nativeAllowList": [
    "app.broadcast",
    "app.exit",
    "clipboard.writeText",
    "events.broadcast",
    "extensions.dispatch",
    "extensions.getStats",
    "filesystem.readFile",
    "filesystem.writeFile",
    "storage.getData",
    "storage.setData"
  ],
  "extensions": [
    {
      "id": "pi-backend",
      "commandWindows": "node ${NL_PATH}\\src\\backend\\main.js",
      "commandLinux": "node ${NL_PATH}/src/backend/main.js",
      "commandDarwin": "node ${NL_PATH}/src/backend/main.js"
    }
  ],
  "modes": {
    "window": {
      "title": "Pinguin",
      "width": 1100,
      "height": 700,
      "webviewArgs": "--disable-gpu",
      "fullScreen": false
    }
  },
  "cli": {
    "binaryName": "pinguin",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/neutralino.js",
    "binaryVersion": "6.7.0",
    "frontendLibrary": {
      "patchFile": "/index.html",
      "devUrl": "http://localhost:5173",
      "devCommand": "npm run dev:webview",
      "buildCommand": "npm run build:webview",
      "projectPath": "."
    }
  }
}
